{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rizal-portfolio",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
